#pragma once
// Copy this file to include/secrets.h (same folder, without .example) and fill
// in your own values. secrets.h is git-ignored, so credentials never leak.
//
//   copy include\secrets.h.example include\secrets.h
//
// ESP32 and the PC must be on the same LAN. Find the PC address with `ipconfig`
// (the adapter that shares a subnet with the ESP32's WiFi) and open TCP 8765 in
// Windows Firewall. If the PC has no WiFi adapter, the ESP32 must join an access
// point that bridges into the PC's wired subnet.

// WiFi 凭据。这里写的是「出厂默认值」：设备也可以不重新烧固件就换网——
// 网页 live.html 的「连接 WiFi」或串口 `wifi connect <ssid> <pass>` 会把凭据
// 写进设备 NVS，并优先于下面这两行；`wifi clear` 删掉 NVS 后才回落到这里。
#define LAMP_WIFI_SSID "YOUR_WIFI_NAME"
#define LAMP_WIFI_PASS "YOUR_WIFI_PASSWORD"

// PC running server/voice_server.py
#define LAMP_VOICE_SERVER_HOST "192.168.1.100"
#define LAMP_VOICE_SERVER_PORT 8765

// Cloud ASR key. 写在这里就编译进固件，不用再连串口敲 `key`；
// 留空则只认串口写入、存 NVS 的那份（NVS 优先）。
//   provider=3（阿里云百炼）：只需要 API Key，形如 sk-xxxxxxxx
//   provider=1/2（百度）：API Key + Secret Key 两个都要
// #define LAMP_CLOUD_API_KEY "sk-xxxxxxxx"
// #define LAMP_CLOUD_SECRET_KEY ""

// 第二跳（语义判断）单独换一家：填了就改走腾讯云 TokenHub，第一跳不受影响。
// 腾讯模型 Key 也是 sk- 开头，走 Bearer，不需要 SecretId、不签名、不对时。
// 留空 = 沿用旧行为（provider=3 用一个百炼 Key 打两跳）。
// #define LAMP_CLOUD_LLM_KEY "sk-xxxxxxxx"
// #define LAMP_TENCENT_LLM_HOST "api.hunyuan.cloud.tencent.com"
// #define LAMP_TENCENT_LLM_MODEL "deepseek-v3"